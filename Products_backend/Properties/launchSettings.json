{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      // для автоматического включения swagger поменяйтс launchBrowser с false на true и уберите двойной слэша у launchUrl
      "launchBrowser": false,
      //"launchUrl": "swagger",
      "applicationUrl": "http://localhost:5062",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      // для автоматического включения swagger поменяйтс launchBrowser с false на true и уберите двойной слэша у launchUrl
      "launchBrowser": false,
      //"launchUrl": "swagger",
      "applicationUrl": "https://localhost:7152;http://localhost:5062",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
